<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UI%20Toolkit/Design.uss?fileID=7433441132597879392&amp;guid=db6abca3d152003d1a5db431c66cc6b0&amp;type=3#Design" />
    <ui:VisualElement name="Main" class="surface">
        <ui:VisualElement name="StatusBar" class="status-bar" />
        <ui:TabView class="navigation-rail">
            <ui:Tab icon-image="project://database/Assets/UI/Icons/Tools/add.png?fileID=2800000&amp;guid=7b5a6c828aac174a2839b77743d73c5a&amp;type=3#add" name="Tab">
                <ui:Label text="Welcome!" />
            </ui:Tab>
        </ui:TabView>
    </ui:VisualElement>
    <ui:VisualElement name="Loading" class="surface" style="flex-grow: 1; align-items: center; align-content: center; justify-content: center; overflow: hidden; top: 0; left: 0; bottom: 0; right: 0; position: absolute; display: none;">
        <ui:VisualElement name="Logo" class="image-tinted" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/Logos/rosebyte-white.png?fileID=2800000&amp;guid=2897d00e111ca0854be3b39628ab889a&amp;type=3#rosebyte-white&quot;); width: 400px; -unity-background-scale-mode: scale-to-fit; align-content: center; align-items: center; align-self: center; max-height: 100px;" />
        <ui:ProgressBar value="0" style="width: 400px; position: absolute; bottom: 150px;" />
    </ui:VisualElement>
</ui:UXML>
